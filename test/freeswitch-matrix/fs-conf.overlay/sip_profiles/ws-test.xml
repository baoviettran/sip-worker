<profile name="ws-test">
  <settings>
  <param name="sip-ip" value="127.0.0.1"/>
  <param name="sip-port" value="__SIP_PORT__"/>
  <param name="rtp-ip" value="127.0.0.1"/>
  <param name="rtp-start-port" value="20000"/>
  <param name="rtp-end-port" value="20100"/>
  <param name="ext-sip-ip" value="127.0.0.1"/>
  <param name="ext-rtp-ip" value="127.0.0.1"/>
  <!-- Which of the peer's ICE candidates FreeSWITCH will check. Left unset it
       defaults to the auto-generated `wan.auto`, which denies every private
       range and so admits only a loopback candidate; Chromium's ICE socket is
       on loopback and works, Firefox's is on the LAN interface and does not.
       See autoload_configs/acl.conf.xml. -->
  <param name="apply-candidate-acl" value="matrix.auto"/>
  <param name="dialplan" value="XML"/>
  <param name="context" value="default"/>
  <param name="auth-calls" value="true"/>
  <param name="accept-blind-reg" value="false"/>
  <param name="accept-blind-auth" value="false"/>
  <param name="inbound-codec-prefs" value="OPUS,PCMU,PCMA"/>
  <param name="outbound-codec-prefs" value="OPUS,PCMU,PCMA"/>
  <param name="inbound-codec-negotiation" value="generous"/>
  <param name="dtmf-type" value="rfc2833"/>
  <param name="ws-binding" value="127.0.0.1:__WS_PORT__"/>
  <param name="wss-binding" value="127.0.0.1:__WSS_PORT__"/>
  <domain name="127.0.0.1">
    <params>
      <param name="dial-string" value="{^^:sip_invite_domain=${dialed_domain}:presence_id=${dialed_user}@${dialed_domain}}${sofia_contact(*/${dialed_user}@${dialed_domain})}"/>
    </params>
  </domain>
  </settings>
</profile>
