{
  "name": "sip-worker",
  "version": "0.5.0",
  "description": "Browser SIP user agent (RFC 3261) with real WebRTC audio, as a TypeScript library.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baoviettran/sip-worker.git"
  },
  "support": {
    "docs": "https://github.com/baoviettran/sip-worker#readme",
    "url": "https://github.com/baoviettran/sip-worker/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js",
      "require": "./dist/transport/index.cjs"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "import": "./dist/media/index.js",
      "require": "./dist/media/index.cjs"
    }
  },
  "dependencies": {
    "@sip-worker/core": "0.5.0"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build && node ../../test/package/prepack-check.mjs",
    "typecheck:test": "tsc --project tsconfig.test.json --noEmit",
    "api:local": "api-extractor run --local --config api-extractor.json",
    "api:check": "api-extractor run --config api-extractor.json"
  }
}
